  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Private user account profile isolated to userId == request.auth.uid."
    },
    "/businesses/{businessId}": {
      "schema": "Business",
      "description": "Business workspace configuration owned by ownerId == request.auth.uid."
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "CRM customer records belonging to an authenticated user's business."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Orders belonging to an authenticated user's business."
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Recorded payments linked to orders within the user's business."
    },
    "/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Business expense records belonging to an authenticated user's business."
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Auto-generated and manual tasks scoped to an authenticated user's business."
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "In-app notifications scoped to an authenticated user's business."
    }
  }
}
