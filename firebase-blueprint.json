{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated SoloDesk user account and preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the user."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Display name of the business owner."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "description": "Account email address (private to owner)."
        },
        "businessId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Associated business document ID."
        },
        "onboardingCompleted": {
          "type": "boolean",
          "description": "Whether initial business setup has been completed."
        },
        "plan": {
          "type": "string",
          "enum": ["free", "solo"],
          "maxLength": 16,
          "description": "Account plan tier."
        },
        "theme": {
          "type": "string",
          "enum": ["light", "dark"],
          "maxLength": 16,
          "description": "UI color mode preference."
        },
        "notificationsEnabled": {
          "type": "boolean",
          "description": "Whether in-app deadline and payment alerts are active."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "uid",
        "name",
        "email",
        "businessId",
        "onboardingCompleted",
        "plan",
        "theme",
        "notificationsEnabled",
        "createdAt",
        "updatedAt"
      ]
    },
    "Business": {
      "title": "Business",
      "description": "Small business workspace owned by an authenticated sole trader.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Business ID (matches owner UID for 1:1 isolation)."
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the owning user."
        },
        "ownerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Name of the business owner."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140,
          "description": "Trading name of the business."
        },
        "businessType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Category of small business (e.g., Illustrator, Baker, Craft Seller)."
        },
        "currency": {
          "type": "string",
          "enum": ["GBP", "EUR", "USD", "RON"],
          "maxLength": 8,
          "description": "ISO currency code used across orders and expenses."
        },
        "plan": {
          "type": "string",
          "enum": ["free", "solo"],
          "maxLength": 16,
          "description": "Subscription tier architecture."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "id",
        "ownerId",
        "ownerName",
        "name",
        "businessType",
        "currency",
        "plan",
        "createdAt",
        "updatedAt"
      ]
    },
    "Customer": {
      "title": "Customer",
