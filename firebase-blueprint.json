      "description": "In-app alert for deadlines, overdue orders, tasks due today, or outstanding balances.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
